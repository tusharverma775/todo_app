# Dependencies
node_modules/
client/node_modules/
server/node_modules/

# Build output
dist/
client/dist/
server/dist/
*.tsbuildinfo

# Environment variables (secrets), but keep the examples
.env
.env.*
!.env.example
client/.env
server/.env

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Test and coverage output
coverage/
.vitest-cache/

# Vite cache
.vite/
client/.vite/

# OS files
.DS_Store
Thumbs.db

# Editor and IDE files
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
*.swo

# Local database files (if you run MongoDB locally with a data folder)
data/db/